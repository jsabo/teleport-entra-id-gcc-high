# The connector you fill in holds your tenant, application and group IDs.
connector.yaml

# Terraform state, provider cache and your variable file.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.auto.tfvars

# tbot.yaml holds the registration secret; storage and identity hold keys.
tbot/tbot.yaml
tbot/storage/
tbot/identity/
